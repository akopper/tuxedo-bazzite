#!/usr/bin/env bash
set -euo pipefail

# ── Kumiko theme ───────────────────────────────────────────────────────────
# Installs the Kumiko Deco wallpaper and the matching Noctalia palette, then
# switches Noctalia over to them. Noctalia's niri template generates the
# window colours in noctalia.kdl; no separate niri theme is pinned.
#
# Re-running is safe: files are replaced, the niri include is kept exactly
# once, and the last line of config.kdl is always the Noctalia include.

THEME_NAME="Kumiko"
ASSET_DIR="${KUMIKO_ASSET_DIR:-/usr/share/kumiko}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
NIRI_DIR="$CONFIG_HOME/niri"
NIRI_CONFIG="$NIRI_DIR/config.kdl"
PALETTE_DIR="$CONFIG_HOME/noctalia/palettes"
HOOK_DIR="$CONFIG_HOME/noctalia/hooks"
GTK_HOOK="$HOOK_DIR/kumiko-gtk-mode.sh"
BAR_FG="#e8e2d8"

PICTURES_DIR="$(xdg-user-dir PICTURES 2>/dev/null || true)"
if [ -z "$PICTURES_DIR" ] || [ "$PICTURES_DIR" = "$HOME" ]; then
    PICTURES_DIR="$HOME/Pictures"
fi
WALLPAPER_DIR="$PICTURES_DIR/Wallpapers"
WALLPAPER="$WALLPAPER_DIR/kumiko-deco.png"

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

# ── Noctalia helpers ───────────────────────────────────────────────────────
# Fixed cream instead of a palette role: the wallpaper is always dark, so
# on_surface would turn near-black in light mode and become unreadable.
set_bar_colors() {
    noctalia msg config-set bar.default.color "\"$BAR_FG\"" >/dev/null
    noctalia msg config-set bar.default.icon_color "\"$BAR_FG\"" >/dev/null
}

# Merge gtk3/gtk4 into the enabled built-in templates without dropping any
# templates the user already had.
enable_gtk_templates() {
    local ids id out
    ids="$(noctalia msg config-get theme.templates.builtin_ids 2>/dev/null || true)"
    out=""
    for id in $(printf '%s\n' "$ids" | grep -oE "[\"'][^\"']*[\"']" | tr -d "\"'"); do
        out="${out:+$out, }\"$id\""
    done
    for id in niri gtk3 gtk4; do
        case " $out " in
            *"\"$id\""*) ;;
            *) out="${out:+$out, }\"$id\"" ;;
        esac
    done
    noctalia msg config-set theme.templates.builtin_ids "[$out]" >/dev/null
}

# Noctalia's GTK apply hook does not touch color-scheme on runtime mode
# changes, so keep GNOME-facing apps in step ourselves. Prefer dconf:
# Homebrew's gsettings may be ahead in PATH and writes a keyfile backend.
write_gtk_hook() {
    mkdir -p "$HOOK_DIR"
    cat >"$GTK_HOOK" <<'EOF'
#!/usr/bin/env bash
# Installed by ujust setup-kumiko. Keep GTK apps in step with Noctalia's
# resolved light/dark mode.
set -euo pipefail
case "${NOCTALIA_THEME_MODE:-dark}" in
    light) theme=adw-gtk3; scheme=prefer-light ;;
    *)     theme=adw-gtk3-dark; scheme=prefer-dark ;;
esac
if command -v dconf >/dev/null 2>&1; then
    dconf write /org/gnome/desktop/interface/gtk-theme "'$theme'"
    dconf write /org/gnome/desktop/interface/color-scheme "'$scheme'"
elif command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.interface gtk-theme "$theme"
    gsettings set org.gnome.desktop.interface color-scheme "$scheme"
fi
EOF
    chmod 755 "$GTK_HOOK"
}

register_gtk_hook() {
    noctalia msg config-set hooks.theme_mode_changed \
        "\"bash \\\"$GTK_HOOK\\\"\"" >/dev/null
}

# Applied after templates-apply: Noctalia's own GTK hook can race on first
# enable (gtk3 runs before gtk4/noctalia.css exists).
sync_gtk_settings() {
    local mode theme scheme
    mode="$(noctalia msg theme-mode-get 2>/dev/null || true)"
    case "$mode" in
        light) theme=adw-gtk3; scheme=prefer-light ;;
        *)     theme=adw-gtk3-dark; scheme=prefer-dark ;;
    esac
    if command -v dconf >/dev/null 2>&1; then
        dconf write /org/gnome/desktop/interface/gtk-theme "'$theme'"
        dconf write /org/gnome/desktop/interface/color-scheme "'$scheme'"
    elif command -v gsettings >/dev/null 2>&1; then
        gsettings set org.gnome.desktop.interface gtk-theme "$theme"
        gsettings set org.gnome.desktop.interface color-scheme "$scheme"
    fi
}

for f in kumiko-deco-3840x2160.png kumiko-deco-2560x1440.png kumiko-deco.svg \
         Kumiko.json; do
    [ -f "$ASSET_DIR/$f" ] || die "missing asset $ASSET_DIR/$f"
done

# ── Install user files ─────────────────────────────────────────────────────
mkdir -p "$WALLPAPER_DIR" "$PALETTE_DIR" "$NIRI_DIR"

# The 4K render scales cleanly to every panel; keep the native one as an
# alternative for people who want a smaller file.
install -m 644 "$ASSET_DIR/kumiko-deco-3840x2160.png" "$WALLPAPER"
install -m 644 "$ASSET_DIR/kumiko-deco-2560x1440.png" "$WALLPAPER_DIR/kumiko-deco-2560x1440.png"
install -m 644 "$ASSET_DIR/kumiko-deco.svg" "$WALLPAPER_DIR/kumiko-deco.svg"
install -m 644 "$ASSET_DIR/Kumiko.json" "$PALETTE_DIR/Kumiko.json"

# Older installs shipped a pinned niri theme; drop the stale file now that
# Noctalia's generated noctalia.kdl provides the colours.
rm -f "$NIRI_DIR/theme-kumiko.kdl"

# ── Wire the theme into niri ───────────────────────────────────────────────
# Noctalia writes noctalia.kdl when its niri template is applied. Keep that
# include present; setup-kumiko no longer needs a second theme fragment.
touch "$NIRI_DIR/noctalia.kdl"

# A user who never logged into niri before may not have a config yet.
if [ ! -f "$NIRI_CONFIG" ]; then
    printf 'include "/etc/niri/config.kdl"\n' >"$NIRI_CONFIG"
fi

tmp="$(mktemp "${NIRI_CONFIG}.tmp.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

if [ -f "$NIRI_CONFIG" ]; then
    # Drop existing copies of the managed comment and both theme includes
    # (including the old pinned theme); only noctalia.kdl is re-added below.
    # Buffer blank lines so no trailing blanks pile up.
    awk '
        /^[[:space:]]*include([[:space:]].*)?"([^"]*\/)?(noctalia|theme-kumiko)\.kdl"([[:space:]]|$)/ { next }
        /Kumiko theme \(managed by ujust setup-kumiko\)/ { next }
        {
            if ($0 ~ /^[[:space:]]*$/) {
                blank++
            } else {
                while (blank > 0) { print ""; blank-- }
                print
            }
        }
    ' "$NIRI_CONFIG" >"$tmp"
else
    : >"$tmp"
fi

# Keep the file ending in a newline before appending.
[ -s "$tmp" ] && [ -n "$(tail -c 1 "$tmp")" ] && printf '\n' >>"$tmp"
cat >>"$tmp" <<'EOF'

// ── Kumiko theme (managed by ujust setup-kumiko) ──────────────────────────
include "noctalia.kdl"
EOF

cat "$tmp" >"$NIRI_CONFIG"
rm -f "$tmp"
trap - EXIT

# ── Switch Noctalia over (only possible while it is running) ──────────────
write_gtk_hook

if command -v noctalia >/dev/null 2>&1 && noctalia msg color-scheme-get >/dev/null 2>&1; then
    set_bar_colors
    enable_gtk_templates
    register_gtk_hook
    noctalia msg color-scheme-set custom "$THEME_NAME" >/dev/null
    noctalia msg theme-mode-set dark >/dev/null
    noctalia msg wallpaper-set "$WALLPAPER" >/dev/null
    noctalia msg templates-apply >/dev/null 2>&1 || true
    noctalia msg config-reload >/dev/null 2>&1 || true
    sync_gtk_settings
    echo "Noctalia switched to the $THEME_NAME palette and wallpaper."
else
    echo "Noctalia is not running; finish the switch in your next session with:"
    echo "  noctalia msg color-scheme-set custom $THEME_NAME"
    echo "  noctalia msg theme-mode-set dark"
    echo "  noctalia msg wallpaper-set \"$WALLPAPER\""
    echo "  noctalia msg config-set bar.default.color '\"$BAR_FG\"'"
    echo "  noctalia msg config-set bar.default.icon_color '\"$BAR_FG\"'"
    echo "  noctalia msg config-set hooks.theme_mode_changed '\"bash \\\"$GTK_HOOK\\\"\"'"
fi

cat <<EOF

Done.
  wallpaper  $WALLPAPER
  palette    $PALETTE_DIR/$THEME_NAME.json
  niri       $NIRI_DIR/noctalia.kdl (generated by Noctalia)
  include    $NIRI_CONFIG
  gtk hook   $GTK_HOOK

Undo:
  Remove the managed block from $NIRI_CONFIG and run
    noctalia msg color-scheme-set wallpaper m3-content
  so Noctalia derives its colours from the wallpaper again.
EOF
