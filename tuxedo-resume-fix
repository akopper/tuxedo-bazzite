#!/bin/bash
# Post-resume fixups for TUXEDO Stellaris/Polaris laptops.
#
# Started with "systemctl --no-block start" from a systemd-sleep hook so
# that the actual resume is not delayed by any of the waiting below.
#
# Wi-Fi devices are found via the iwlwifi driver binding instead of
# hardcoded PCI addresses/interface names, so this keeps working when
# kernel naming or the hardware changes.

log() { logger -t tuxedo-resume "$*"; }

sleep 2

# --- Wi-Fi -------------------------------------------------------------
# The Intel AX210 sometimes comes back from s2idle with a dead firmware
# (AER fatal on its root port, "Failed to start RT ucode: -110").  Only a
# PCI re-probe brings it back.

wifi_blocked() {
    for rfkill in /sys/class/rfkill/*; do
        [ "$(cat "$rfkill/type" 2>/dev/null)" = "wlan" ] || continue
        [ "$(cat "$rfkill/soft" 2>/dev/null)" = "1" ] && return 0
    done
    return 1
}

# Bring the first iwlwifi-backed interface up; 0 if one is up.
wifi_up() {
    local link ifc
    for link in /sys/class/net/*; do
        [ -e "${link}/device/driver" ] || continue
        [ "$(basename "$(readlink -f "${link}/device/driver")")" = "iwlwifi" ] || continue
        ifc=$(basename "${link}")
        timeout 3 ip link set "${ifc}" up 2>/dev/null && return 0
    done
    return 1
}

# Remove and rescan every PCI device currently bound to iwlwifi.
wifi_reprobe() {
    local dev
    # Collect the devices before unloading the driver - the sysfs
    # driver binding disappears with it.
    local devs=()
    for dev in /sys/bus/pci/drivers/iwlwifi/*/; do
        [ -d "${dev}" ] || continue
        devs+=("$(basename "${dev%/}")")
    done
    if [ ${#devs[@]} -eq 0 ]; then
        log "no iwlwifi PCI device found, skipping re-probe"
        return 0
    fi

    timeout 10 modprobe -r iwlmvm iwlwifi 2>/dev/null
    for dev in "${devs[@]}"; do
        log "Wi-Fi did not come back, re-probing ${dev}"
        echo 1 > "/sys/bus/pci/devices/${dev}/remove" 2>/dev/null
    done
    sleep 1
    echo 1 > /sys/bus/pci/rescan
    modprobe iwlwifi
}

if ! wifi_blocked && ! wifi_up; then
    sleep 1
    if ! wifi_up; then
        wifi_reprobe
    fi
fi

# --- Keyboard ----------------------------------------------------------
# The ITE 8291 LED controller does not survive s2idle: afterwards it only
# lights a handful of keys and ignores every frame until the USB device is
# power cycled.
for d in /sys/bus/usb/devices/*/; do
    [ "$(cat "$d/idVendor" 2>/dev/null)" = "048d" ] || continue
    [ "$(cat "$d/idProduct" 2>/dev/null)" = "6004" ] || continue
    log "power cycling the keyboard ($d)"
    echo 0 > "$d/authorized"
    sleep 1
    echo 1 > "$d/authorized"
    break
done

sleep 2

# --- OpenRGB -----------------------------------------------------------
for uid in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $1}'); do
    user=$(id -nu "$uid" 2>/dev/null) || continue
    runuser -u "$user" -- env XDG_RUNTIME_DIR="/run/user/$uid" \
        systemctl --user try-restart openrgb.service >/dev/null 2>&1
done
