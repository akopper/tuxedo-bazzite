+/*---------------------------------------------------------*\
+| RGBController_TuxedoLightbar.h                            |
+|                                                           |
+|   RGBController for the TUXEDO/Uniwill front lightbar     |
+|                                                           |
+|   This file is part of the OpenRGB project                |
+|   SPDX-License-Identifier: GPL-2.0-or-later               |
+\*---------------------------------------------------------*/
+
+#pragma once
+
+#include "RGBController.h"
+#include "TuxedoLightbarController.h"
+
+enum
+{
+    TUXEDO_LIGHTBAR_MODE_DIRECT     = 0,
+    TUXEDO_LIGHTBAR_MODE_ANIMATION  = 1,
+    TUXEDO_LIGHTBAR_MODE_OFF        = 2
+};
+
+class RGBController_TuxedoLightbar : public RGBController
+{
+public:
+    RGBController_TuxedoLightbar(TuxedoLightbarController* controller_ptr);
+    ~RGBController_TuxedoLightbar();
+
+    void SetupZones();
+
+    void DeviceUpdateLEDs();
+    void DeviceUpdateZoneLEDs(int zone);
+    void DeviceUpdateSingleLED(int led);
+
+    void DeviceUpdateMode();
+
+private:
+    TuxedoLightbarController* controller;
+};
diff --git a/Controllers/TuxedoLightbarController/TuxedoLightbarController.cpp b/Controllers/TuxedoLightbarController/TuxedoLightbarController.cpp
new file mode 100644
index 00000000..fd5f9415
--- /dev/null
+++ b/Controllers/TuxedoLightbarController/TuxedoLightbarController.cpp
@@ -0,0 +1,106 @@
+/*---------------------------------------------------------*\
+| TuxedoLightbarController.cpp                              |
+|                                                           |
+|   Driver for the TUXEDO/Uniwill front lightbar (EC)       |
+|                                                           |
+|   The kernel driver exposes each colour channel as its    |
+|   own LED, so setting a colour means writing three        |
+|   brightness attributes.  max_brightness is 0x24 (36).    |
+|                                                           |
+|   This file is part of the OpenRGB project                |
+|   SPDX-License-Identifier: GPL-2.0-or-later               |
+\*---------------------------------------------------------*/
+
+#include <fstream>
+#include <sys/stat.h>
+#include "TuxedoLightbarController.h"
+
+TuxedoLightbarController::TuxedoLightbarController()
+{
+    unsigned char value = 0;
+
+    if(ReadByte(TUXEDO_LIGHTBAR_MAX_PATH, &value) && value > 0)
+    {
+        max_channel = value;
+    }
+    else
+    {
+        max_channel = TUXEDO_LIGHTBAR_DEFAULT_MAX;
+    }
+}
+
+TuxedoLightbarController::~TuxedoLightbarController()
+{
+}
+
+bool TuxedoLightbarController::IsSupported()
+{
+    struct stat st;
+
+    return(stat(TUXEDO_LIGHTBAR_RED_PATH,       &st) == 0
+        && stat(TUXEDO_LIGHTBAR_GREEN_PATH,     &st) == 0
+        && stat(TUXEDO_LIGHTBAR_BLUE_PATH,      &st) == 0
+        && stat(TUXEDO_LIGHTBAR_ANIMATION_PATH, &st) == 0);
+}
+
+std::string TuxedoLightbarController::GetDeviceLocation()
+{
+    return("sysfs: /sys/class/leds/lightbar_rgb");
+}
+
+std::string TuxedoLightbarController::GetSerialString()
+{
+    return("");
+}
+
+std::string TuxedoLightbarController::GetFirmwareVersion()
+{
+    return("");
+}
+
+unsigned char TuxedoLightbarController::GetMaxChannel()
+{
+    return(max_channel);
+}
+
+void TuxedoLightbarController::SetColor(unsigned char red, unsigned char green, unsigned char blue)
+{
+    WriteByte(TUXEDO_LIGHTBAR_RED_PATH,   red);
+    WriteByte(TUXEDO_LIGHTBAR_GREEN_PATH, green);
+    WriteByte(TUXEDO_LIGHTBAR_BLUE_PATH,  blue);
+}
+
+void TuxedoLightbarController::SetAnimation(bool enabled)
+{
+    WriteByte(TUXEDO_LIGHTBAR_ANIMATION_PATH, enabled ? 1 : 0);
+}
+
+bool TuxedoLightbarController::ReadByte(const char* path, unsigned char* value)
+{
+    std::ifstream file(path);
+    int           read_value;
+
+    if(!(file >> read_value))
+    {
+        return(false);
+    }
+
+    *value = static_cast<unsigned char>(read_value);
+
+    return(true);
+}
+
+bool TuxedoLightbarController::WriteByte(const char* path, unsigned char value)
+{
+    std::ofstream file(path);
+
+    if(!file.is_open())
+    {
+        return(false);
+    }
+
+    file << static_cast<int>(value);
+    file.flush();
+
+    return(file.good());
+}
diff --git a/Controllers/TuxedoLightbarController/TuxedoLightbarController.h b/Controllers/TuxedoLightbarController/TuxedoLightbarController.h
new file mode 100644
index 00000000..005af3b1
--- /dev/null
+++ b/Controllers/TuxedoLightbarController/TuxedoLightbarController.h
@@ -0,0 +1,52 @@
+/*---------------------------------------------------------*\
+| TuxedoLightbarController.h                                |
+|                                                           |
+|   Driver for the TUXEDO/Uniwill front lightbar (EC)       |
+|                                                           |
+|   The lightbar is not a USB HID device.  The TUXEDO       |
+|   kernel driver (tuxedo_keyboard) exposes it through      |
+|   three monochrome LEDs in sysfs, one per colour channel. |
+|                                                           |
+|   This file is part of the OpenRGB project                |
+|   SPDX-License-Identifier: GPL-2.0-or-later               |
+\*---------------------------------------------------------*/
+
+#pragma once
+
+#include <string>
+
+#define TUXEDO_LIGHTBAR_RED_PATH        "/sys/class/leds/lightbar_rgb:1:status/brightness"
+#define TUXEDO_LIGHTBAR_GREEN_PATH      "/sys/class/leds/lightbar_rgb:2:status/brightness"
+#define TUXEDO_LIGHTBAR_BLUE_PATH       "/sys/class/leds/lightbar_rgb:3:status/brightness"
+#define TUXEDO_LIGHTBAR_ANIMATION_PATH  "/sys/class/leds/lightbar_animation::status/brightness"
+#define TUXEDO_LIGHTBAR_MAX_PATH        "/sys/class/leds/lightbar_rgb:1:status/max_brightness"
+
+/*---------------------------------------------------------*\
+| Fallback when max_brightness cannot be read.  The Uniwill |
+| EC uses 0x24 (36) on the Stellaris/Polaris Gen4.          |
+\*---------------------------------------------------------*/
+#define TUXEDO_LIGHTBAR_DEFAULT_MAX     36
+
+class TuxedoLightbarController
+{
+public:
+    TuxedoLightbarController();
+    ~TuxedoLightbarController();
+
+    static bool     IsSupported();
+
+    std::string     GetDeviceLocation();
+    std::string     GetSerialString();
+    std::string     GetFirmwareVersion();
+
+    unsigned char   GetMaxChannel();
+
+    void            SetColor(unsigned char red, unsigned char green, unsigned char blue);
+    void            SetAnimation(bool enabled);
+
+private:
+    unsigned char   max_channel;
+
+    static bool     ReadByte(const char* path, unsigned char* value);
+    static bool     WriteByte(const char* path, unsigned char value);
+};
diff --git a/Controllers/TuxedoLightbarController/TuxedoLightbarControllerDetect_Linux.cpp b/Controllers/TuxedoLightbarController/TuxedoLightbarControllerDetect_Linux.cpp
