@@ -41,3 +41,4 @@
 } clevo_led_override;
 
 extern const std::vector<clevo_led_override> clevo_ite8291_alternate_led_map;
+extern const std::vector<clevo_led_override> clevo_stepol1xa04_led_map;
diff -Naur orig/Controllers/ClevoKeyboardController/RGBController_ClevoKeyboard.cpp new/Controllers/ClevoKeyboardController/RGBController_ClevoKeyboard.cpp
--- a/Controllers/ClevoKeyboardController/RGBController_ClevoKeyboard.cpp	2026-11-01 21:03:13.146583882 +0100
+++ b/Controllers/ClevoKeyboardController/RGBController_ClevoKeyboard.cpp	2026-11-01 21:17:42.606771243 +0100
@@ -382,10 +382,13 @@
     /* Only the measured TUXEDO Stellaris 16 Gen7 AMD layout uses this map.
        Keep all other ITE/Clevo models on their original layout. */
     bool is_stellaris16a07 = false;
+    bool is_stepol1xa04     = false;
     if(!is_829x)
     {
         DMIInfo dmi;
-        is_stellaris16a07 = (dmi.getProductSKU() == "STELLARIS16A07");
+        std::string sku   = dmi.getProductSKU();
+        is_stellaris16a07 = (sku == "STELLARIS16A07");
+        is_stepol1xa04    = (sku == "STEPOL1XA04");
     }
 
 
@@ -400,6 +403,21 @@
     new_kb.ChangeKeys(layout);
 
     /*---------------------------------------------------------*\
+    | Keys the generic Clevo layout drops but that exist here   |
+    | on this model: Pause/Break and the context menu key       |
+    \*---------------------------------------------------------*/
+    if(is_stepol1xa04)
+    {
+        key_set extra_keys =
+        {
+            { 0, 0, 15, 118, KEY_EN_PAUSE_BREAK, KEY_EN_UNUSED, KEYBOARD_OPCODE_INSERT_SHIFT_RIGHT },
+            { 0, 5, 12,  11, KEY_EN_MENU,        KEY_EN_UNUSED, KEYBOARD_OPCODE_INSERT_SHIFT_RIGHT },
+        };
+
+        new_kb.ChangeKeys(extra_keys);
+    }
+
+    /*---------------------------------------------------------*\
     | Create keyboard zone from KLM                             |
     \*---------------------------------------------------------*/
     zone keyboard_zone;
@@ -428,6 +446,24 @@
         default_led_values.push_back(new_led.value);
     }
 
+    /*---------------------------------------------------------*\
+    | Apply the LED map measured on this specific model         |
+    \*---------------------------------------------------------*/
+    if(is_stepol1xa04)
+    {
+        for(std::size_t led_idx = 0; led_idx < leds.size(); led_idx++)
+        {
+            for(const clevo_led_override& entry : clevo_stepol1xa04_led_map)
+            {
+                if(leds[led_idx].name == entry.name)
+                {
+                    leds[led_idx].value         = entry.value;
+                    default_led_values[led_idx] = entry.value;
+                }
+            }
+        }
+    }
+
     SetupColors();
 
     BuildBufferMap();
@@ -456,6 +492,41 @@
             buffer_map[leds[led_idx].value] = &colors[led_idx];
         }
     }
+
+    /*---------------------------------------------------------*\
+    | On the Stellaris/Polaris Gen4 the wide keys are lit by    |
+    | two LEDs in different matrix rows: left Shift (21|22),    |
+    | Caps Lock (42|43) and Enter (56|77). The layout provides  |
+    | one LED per key, so mirror the key colour onto the        |
+    | second LED to light the whole key.                        |
+    \*---------------------------------------------------------*/
+    DMIInfo dmi;
+
+    if(dmi.getProductSKU() == "STEPOL1XA04")
+    {
+        for(size_t led_idx = 0; led_idx < leds.size(); led_idx++)
+        {
+            unsigned int second_led = 0;
+
+            if(leds[led_idx].name == KEY_EN_LEFT_SHIFT)
+            {
+                second_led = 22;
+            }
+            else if(leds[led_idx].name == KEY_EN_CAPS_LOCK)
+            {
+                second_led = 43;
+            }
+            else if(leds[led_idx].name == KEY_EN_ANSI_ENTER)
+            {
+                second_led = 77;
+            }
+
+            if(second_led != 0 && second_led < buffer_map.size())
+            {
+                buffer_map[second_led] = &colors[led_idx];
+            }
+        }
+    }
 }
 
