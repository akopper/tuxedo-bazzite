@@ -0,0 +1,33 @@
+/*---------------------------------------------------------*\
+| TuxedoLightbarControllerDetect_Linux.cpp                  |
+|                                                           |
+|   Detector for the TUXEDO/Uniwill front lightbar          |
+|                                                           |
+|   The lightbar is not enumerated over USB.  The TUXEDO    |
+|   kernel driver exposes it as three sysfs LEDs, so the    |
+|   detector only has to check that those LEDs exist.       |
+|                                                           |
+|   This file is part of the OpenRGB project                |
+|   SPDX-License-Identifier: GPL-2.0-or-later               |
+\*---------------------------------------------------------*/
+
+#include "DetectionManager.h"
+#include "RGBController_TuxedoLightbar.h"
+#include "TuxedoLightbarController.h"
+
+DetectedControllers DetectTuxedoLightbarControllers()
+{
+    DetectedControllers detected_controllers;
+
+    if(TuxedoLightbarController::IsSupported())
+    {
+        TuxedoLightbarController*     controller     = new TuxedoLightbarController();
+        RGBController_TuxedoLightbar* rgb_controller = new RGBController_TuxedoLightbar(controller);
+
+        detected_controllers.push_back(rgb_controller);
+    }
+
+    return(detected_controllers);
+}
+
+REGISTER_DETECTOR("TUXEDO Lightbar", DetectTuxedoLightbarControllers);
