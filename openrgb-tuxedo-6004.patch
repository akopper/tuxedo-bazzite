diff --git a/Controllers/TuxedoLightbarController/RGBController_TuxedoLightbar.cpp b/Controllers/TuxedoLightbarController/RGBController_TuxedoLightbar.cpp
new file mode 100644
index 00000000..71e8b2ae
--- /dev/null
+++ b/Controllers/TuxedoLightbarController/RGBController_TuxedoLightbar.cpp
@@ -0,0 +1,147 @@
+/*---------------------------------------------------------*\
+| RGBController_TuxedoLightbar.cpp                          |
+|                                                           |
+|   RGBController for the TUXEDO/Uniwill front lightbar     |
+|                                                           |
+|   OpenRGB colours are 8-bit, the EC accepts 0..max_channel |
+|   (0x24 = 36) per channel, so the colour is scaled here.  |
+|                                                           |
+|   This file is part of the OpenRGB project                |
+|   SPDX-License-Identifier: GPL-2.0-or-later               |
+\*---------------------------------------------------------*/
+
+#include "RGBController_TuxedoLightbar.h"
+
+/**------------------------------------------------------------------*\
+    @name TUXEDO Lightbar
+    @category LEDStrip
+    @type USB
+    @save :x:
+    @direct :white_check_mark:
+    @effects :white_check_mark:
+    @detectors DetectTuxedoLightbarControllers
+    @comment Front lightbar on TUXEDO/Uniwill laptops (EC, sysfs)
+\*-------------------------------------------------------------------*/
+
+RGBController_TuxedoLightbar::RGBController_TuxedoLightbar(TuxedoLightbarController* controller_ptr)
+{
+    controller  = controller_ptr;
+
+    name        = "TUXEDO Lightbar";
+    vendor      = "TUXEDO Computers";
+    type        = DEVICE_TYPE_LEDSTRIP;
+    description = "TUXEDO front lightbar (Uniwill EC)";
+    location    = controller->GetDeviceLocation();
+    serial      = controller->GetSerialString();
+    version     = controller->GetFirmwareVersion();
+
+    mode Direct;
+    Direct.name           = "Direct";
+    Direct.value          = TUXEDO_LIGHTBAR_MODE_DIRECT;
+    Direct.flags          = MODE_FLAG_HAS_PER_LED_COLOR | MODE_FLAG_HAS_BRIGHTNESS;
+    Direct.color_mode     = MODE_COLORS_PER_LED;
+    Direct.brightness_min = 0;
+    Direct.brightness_max = 100;
+    Direct.brightness     = 100;
+    modes.push_back(Direct);
+
+    mode Animation;
+    Animation.name       = "Animation";
+    Animation.value      = TUXEDO_LIGHTBAR_MODE_ANIMATION;
+    Animation.flags      = 0;
+    Animation.color_mode = MODE_COLORS_NONE;
+    modes.push_back(Animation);
+
+    mode Off;
+    Off.name       = "Off";
+    Off.value      = TUXEDO_LIGHTBAR_MODE_OFF;
+    Off.flags      = 0;
+    Off.color_mode = MODE_COLORS_NONE;
+    modes.push_back(Off);
+
+    SetupZones();
+}
+
+RGBController_TuxedoLightbar::~RGBController_TuxedoLightbar()
+{
+    Shutdown();
+
+    delete controller;
+}
+
+void RGBController_TuxedoLightbar::SetupZones()
+{
+    zone lightbar_zone;
+    lightbar_zone.name       = "Lightbar";
+    lightbar_zone.type       = ZONE_TYPE_SINGLE;
+    lightbar_zone.leds_min   = 1;
+    lightbar_zone.leds_max   = 1;
+    lightbar_zone.leds_count = 1;
+    zones.push_back(lightbar_zone);
+
+    led lightbar_led;
+    lightbar_led.name = "Lightbar";
+    leds.push_back(lightbar_led);
+
+    SetupColors();
+}
+
+void RGBController_TuxedoLightbar::DeviceUpdateLEDs()
+{
+    if(modes[active_mode].value != TUXEDO_LIGHTBAR_MODE_DIRECT)
+    {
+        return;
+    }
+
+    unsigned int max_channel = controller->GetMaxChannel();
+    unsigned int brightness  = modes[active_mode].brightness;
+
+    unsigned int red   = RGBGetRValue(colors[0]);
+    unsigned int green = RGBGetGValue(colors[0]);
+    unsigned int blue  = RGBGetBValue(colors[0]);
+
+    /*---------------------------------------------------------*\
+    | Scale 0..255 and the 0..100 brightness slider down to     |
+    | the EC range.  Round to the nearest step.                 |
+    \*---------------------------------------------------------*/
+    red   = (red   * brightness * max_channel + 12750) / 25500;
+    green = (green * brightness * max_channel + 12750) / 25500;
+    blue  = (blue  * brightness * max_channel + 12750) / 25500;
+
+    controller->SetColor(static_cast<unsigned char>(red),
+                         static_cast<unsigned char>(green),
+                         static_cast<unsigned char>(blue));
+    controller->SetAnimation(false);
+}
+
+void RGBController_TuxedoLightbar::DeviceUpdateZoneLEDs(int /*zone*/)
+{
+    DeviceUpdateLEDs();
+}
+
+void RGBController_TuxedoLightbar::DeviceUpdateSingleLED(int /*led*/)
+{
+    DeviceUpdateLEDs();
+}
+
+void RGBController_TuxedoLightbar::DeviceUpdateMode()
+{
+    switch(modes[active_mode].value)
+    {
+        case TUXEDO_LIGHTBAR_MODE_DIRECT:
+            DeviceUpdateLEDs();
+            break;
+
+        case TUXEDO_LIGHTBAR_MODE_ANIMATION:
+            controller->SetAnimation(true);
+            break;
+
+        case TUXEDO_LIGHTBAR_MODE_OFF:
+            controller->SetColor(0, 0, 0);
+            controller->SetAnimation(false);
+            break;
+
+        default:
+            break;
+    }
+}
