diff --git a/Controllers/ClevoKeyboardController/ClevoKeyboardDevices.cpp b/Controllers/ClevoKeyboardController/ClevoKeyboardDevices.cpp
index 6d1424e..d38d852 100644
--- a/Controllers/ClevoKeyboardController/ClevoKeyboardDevices.cpp
+++ b/Controllers/ClevoKeyboardController/ClevoKeyboardDevices.cpp
@@ -210,6 +210,27 @@ const std::vector<clevo_led_override> clevo_ite8291_alternate_led_map =
     { KEY_EN_ISO_BACK_SLASH,    23  },
 };
 
+/*---------------------------------------------------------*| TUXEDO Stellaris/Polaris AMD Gen4 (DMI SKU STEPOL1XA04)   |
+|   Measured on the hardware: only these keys are wired    |
+|   differently from clevo_tkl_values. Wide keys (Shift,   |
+|   Enter, Caps Lock) drive more than one LED; the first    |
+|   one is used here. Keys without a dedicated LED (Insert, |
+|   Home, Page Up) are parked on unused indices.            |
+\*---------------------------------------------------------*/
+const std::vector<clevo_led_override> clevo_stepol1xa04_led_map =
+{
+    { KEY_EN_RIGHT_SHIFT,      34  },
+    { KEY_EN_UP_ARROW,         35  },
+    { KEY_EN_DOWN_ARROW,       14  },
+    { KEY_EN_ISO_BACK_SLASH,   23  },
+    { KEY_EN_NUMPAD_PLUS,      122 },
+    { KEY_EN_NUMPAD_MINUS,     121 },
+    { KEY_EN_PRINT_SCREEN,     119 },
+    { KEY_EN_INSERT,           123 },
+    { KEY_EN_HOME,             124 },
+    { KEY_EN_PAGE_UP,          125 },
+};
+
 /*---------------------------------------------------------*\
 | TUXEDO Stellaris 16 Gen7 AMD (STELLARIS16A07)             |
 | ITE 8291 (USB 048d:600b), 102 physical ISO keys.          |
