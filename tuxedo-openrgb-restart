#!/bin/bash
# OpenRGB keeps the hidraw handle it opened at startup.  After a s2idle
# resume the keyboard no longer accepts frames through that handle, so the
# profile OpenRGB loads on resume never reaches it and the keyboard keeps
# showing whatever the firmware happens to display.  Restarting the service
# gives OpenRGB a fresh handle and re-applies the open profile.

[ "$1" = "post" ] || exit 0

sleep 3

for uid in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $1}'); do
    user=$(id -nu "$uid" 2>/dev/null) || continue
    runuser -u "$user" -- env XDG_RUNTIME_DIR="/run/user/$uid" \
        systemctl --user try-restart openrgb.service >/dev/null 2>&1
done
