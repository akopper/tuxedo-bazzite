#!/bin/bash
# Recover the Intel Wi-Fi card after s2idle resume.
#
# On this platform (TUXEDO Stellaris/Polaris Gen4, AMD) the AX210 sometimes
# comes back from s2idle with a dead firmware: the root port logs an
# uncorrectable AER error, iwlwifi loops on "HW error, resetting before
# reading" and "Failed to start RT ucode: -110".  rfkill / NetworkManager
# toggles do not help, only a full PCI re-probe of the card does.

DEV="0000:04:00.0"
IF="wlp4s0"

[ "$1" = "post" ] || exit 0

# leave Wi-Fi alone if it was switched off before suspending
for rfkill in /sys/class/rfkill/*; do
    [ "$(cat "$rfkill/type" 2>/dev/null)" = "wlan" ] || continue
    [ "$(cat "$rfkill/soft" 2>/dev/null)" = "1" ] && exit 0
done

# if the interface comes up the card survived, nothing to do
for _ in 1 2 3 4 5; do
    if [ -e "/sys/class/net/$IF" ] && timeout 3 ip link set "$IF" up 2>/dev/null; then
        exit 0
    fi
    sleep 1
done

logger -t tuxedo-wifi "Wi-Fi did not come back after resume, re-probing $DEV"

timeout 10 modprobe -r iwlmvm iwlwifi 2>/dev/null

if [ -e "/sys/bus/pci/devices/$DEV" ]; then
    echo 1 > "/sys/bus/pci/devices/$DEV/remove" 2>/dev/null
    sleep 1
fi

echo 1 > /sys/bus/pci/rescan
modprobe iwlwifi
